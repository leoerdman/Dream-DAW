{
    "productName": "Dream DAW",
    "version": "1.0.474",
    "identifier": "com.dreamdaw.desktop",
    "build": {
        "frontendDist": "../../frontend/ui_app/dist",
        "devUrl": "http://localhost:5179",
        "beforeDevCommand": "bash -lc 'for p in 5179 5180; do pids=$(lsof -ti tcp:$p -sTCP:LISTEN 2>/dev/null || true); if [ -n \"$pids\" ]; then kill $pids 2>/dev/null || true; sleep 0.2; fi; done; pnpm --filter ui_app dev -- --port 5179 --strictPort'",
        "beforeBuildCommand": "pnpm --filter ui_app build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Dream DAW",
                "width": 1400,
                "height": 900,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "backgroundColor": "#0f0f0f",
                "maximizable": true,
                "maximized": true,
                "center": true,
                "visible": false
            },
            {
                "label": "splashscreen",
                "title": "Welcome",
                "width": 500,
                "height": 500,
                "resizable": false,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "backgroundColor": "#00000000",
                "center": true,
                "url": "/splash.html"
            }
        ],
        "security": {
            "csp": null
        },
        "macOSPrivateApi": true
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "entitlements": null,
            "infoPlist": "Info.plist"
        }
    }
}
