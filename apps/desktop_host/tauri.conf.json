{
    "productName": "Dream DAW",
    "version": "1.0.3",
    "identifier": "com.dreamdaw.desktop",
    "build": {
        "frontendDist": "../../frontend/ui_app/dist",
        "devUrl": "http://localhost:5179",
        "beforeDevCommand": "pnpm --filter ui_app dev -- --port 5179 --strictPort",
        "beforeBuildCommand": "pnpm --filter ui_app build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Dream DAW",
                "width": 1400,
                "height": 900,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "maximizable": true,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "entitlements": null,
            "infoPlist": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\"><plist version=\"1.0\"><dict><key>NSMicrophoneUsageDescription</key><string>Dream DAW uses the microphone for voice input to the AI assistant and audio recording.</string><key>NSSpeechRecognitionUsageDescription</key><string>Dream DAW uses speech recognition for voice-to-text input in the AI assistant.</string></dict></plist>"
        }
    }
}
